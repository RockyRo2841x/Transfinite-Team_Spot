TEXT 2080 1536 Left 1 ;Phone calculates calibrated Z = V / I.
TEXT 2080 1584 Left 1 ;Single frequency: 50 kHz.
TEXT 2080 1632 Left 1 ;No fluid-volume or HF conversion here.
TEXT 64 1824 Left 1 !.include Inputs.inc\n.include Readable-Models.lib\n.ac list {BIO_FREQ_HZ}\n.options plotwinsize=0 numdgt=7 meascplxfmt=cartesian\n.save V(BIO_V) V(BIO_I) V(CAL_V) V(CAL_I) V(SENSE_P) V(SENSE_N) I(VSENSE) V(BODY_L) V(BODY_R)\n.meas AC CURRENT_A FIND mag(I(VSENSE)) AT={BIO_FREQ_HZ}\n.meas AC SENSE_V FIND mag(V(SENSE_P,SENSE_N)) AT={BIO_FREQ_HZ}\n.meas AC RAW_MAG_OHM FIND mag(V(BIO_V)/V(BIO_I)*RTIA_OHM) AT={BIO_FREQ_HZ}\n.meas AC R_OHM FIND re(((V(BIO_V)/V(BIO_I))/(V(CAL_V)/V(CAL_I))*RCAL_OHM)) AT={BIO_FREQ_HZ}\n.meas AC X_OHM FIND im(((V(BIO_V)/V(BIO_I))/(V(CAL_V)/V(CAL_I))*RCAL_OHM)) AT={BIO_FREQ_HZ}\n.meas AC MAG_OHM FIND mag(((V(BIO_V)/V(BIO_I))/(V(CAL_V)/V(CAL_I))*RCAL_OHM)) AT={BIO_FREQ_HZ}\n.meas AC PHASE_DEG FIND ph(((V(BIO_V)/V(BIO_I))/(V(CAL_V)/V(CAL_I))*RCAL_OHM)) AT={BIO_FREQ_HZ}
