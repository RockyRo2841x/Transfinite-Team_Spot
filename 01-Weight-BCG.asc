WIRE 768 1296 640 1296
FLAG 704 1296 TOTAL_LOAD_KG
WIRE 1088 1296 960 1296
FLAG 1088 1296 STRAIN
TEXT 768 1376 Left 1 ;Controls bridge resistance above.
TEXT 1280 1264 Left 1 ;BCG path: two 0.72 Hz high-pass stages; 12.2 Hz low-pass.
TEXT 1280 1312 Left 1 ;Weight path: two buffered 0.234 Hz low-pass stages.
TEXT 1280 1392 Left 1 ;Named MID and ground are shared reference rails.
TEXT 1280 1440 Left 1 ;Blocks are simulation models, not a finished PCB.
FLAG 128 1056 WEIGHT_INPUT_KG
FLAG 128 1216 HEART_LOAD_KG
FLAG 128 1376 RESP_LOAD_KG
FLAG 128 1536 MOTION_LOAD_KG
TEXT 64 1744 Left 1 !.include Inputs.inc\n.include Readable-Models.lib\n.tran 0 {T_STOP} 0 1m\n.options plotwinsize=0 numdgt=7\n.save V(WLP2) V(MID) V(WEIGHT_INPUT_KG) V(WEIGHT_OUT_KG) V(TOTAL_LOAD_KG) V(BRIDGE_P) V(BRIDGE_N) V(AFE_OUT) V(BCG_OUT) V(BCG_CLIP_FLAG) V(HEART_LOAD_KG) V(MOTION_LOAD_KG)\n.meas TRAN WEIGHT_KG AVG V(WEIGHT_OUT_KG) FROM=8 TO=12\n.meas TRAN BRIDGE_DIFF_V AVG V(BRIDGE_P,BRIDGE_N) FROM=8 TO=12\n.meas TRAN BCG_PP_V PP V(BCG_OUT) FROM=8 TO=12\n.meas TRAN BCG_PERIOD_S TRIG V(BCG_OUT) VAL={EXCITATION_V/2} TD=2 RISE=1 TARG V(BCG_OUT) VAL={EXCITATION_V/2} TD=2 RISE=5\n.meas TRAN BCG_HEART_BPM PARAM 240/BCG_PERIOD_S\n.meas TRAN CLIPPING_MAX MAX V(BCG_CLIP_FLAG) FROM=0 TO=12
