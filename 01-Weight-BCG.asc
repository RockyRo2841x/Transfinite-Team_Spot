TEXT 64 976 Left 3 ;4. Virtual patient inputs - engineering fixtures
SYMBOL voltage 128 1040 R0
WINDOW 0 0 0 Invisible 0
WINDOW 3 0 0 Invisible 0
SYMATTR InstName VWEIGHT
SYMATTR Value PWL(0 {WEIGHT_START_KG} {T_CHANGE} {WEIGHT_START_KG} {T_CHANGE+0.2} {WEIGHT_FINAL_KG} {T_STOP} {WEIGHT_FINAL_KG})
TEXT 176 1056 Left 1 ;VWEIGHT
TEXT 192 1104 Left 1 ;Weight: 1 V = 1 kg
WIRE 128 1168 128 1136
FLAG 128 1168 0
WIRE 384 1056 128 1056
SYMBOL bv 128 1200 R0
WINDOW 0 0 0 Invisible 0
WINDOW 3 0 0 Invisible 0
SYMATTR InstName BHEART
SYMATTR Value V=BCG_EQUIV_KG*(sin(2*pi*HEART_BPM/60*time)+0.35*sin(4*pi*HEART_BPM/60*time)+0.15*sin(6*pi*HEART_BPM/60*time))
TEXT 176 1216 Left 1 ;BHEART
TEXT 192 1264 Left 1 ;Heartbeat force
WIRE 128 1328 128 1296
FLAG 128 1328 0
WIRE 384 1216 128 1216
SYMBOL bv 128 1360 R0
WINDOW 0 0 0 Invisible 0
WINDOW 3 0 0 Invisible 0
SYMATTR InstName BRESP
SYMATTR Value V=RESP_EQUIV_KG*sin(2*pi*BREATHS_PER_MIN/60*time)
TEXT 176 1376 Left 1 ;BRESP
TEXT 192 1424 Left 1 ;Breathing force
WIRE 128 1488 128 1456
FLAG 128 1488 0
WIRE 384 1376 128 1376
SYMBOL bv 128 1520 R0
WINDOW 0 0 0 Invisible 0
WINDOW 3 0 0 Invisible 0
SYMATTR InstName BMOTION
SYMATTR Value V=MOTION_KG*sin(2*pi*4.5*time)*(u(time-4)-u(time-7))
TEXT 176 1536 Left 1 ;BMOTION
TEXT 192 1584 Left 1 ;Motion artefact
WIRE 128 1648 128 1616
FLAG 128 1648 0
WIRE 384 1536 128 1536
